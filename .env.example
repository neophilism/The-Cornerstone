# Synthetic local development only. Never copy test credentials into a hosted environment.
NODE_ENV=development
CORNERSTONE_MODE=simulation
DATA_REALM=simulation
DATABASE_URL=postgresql://cornerstone_runtime:local_test_only@localhost:5432/cornerstone
MIGRATION_DATABASE_URL=postgresql://cornerstone_migration:local_test_only@localhost:5432/cornerstone
WORKER_DATABASE_URL=postgresql://cornerstone_worker:local_worker_test_only@localhost:5432/cornerstone
API_PORT=4010
API_INTERNAL_URL=http://localhost:4010
PORTAL_ORIGIN=http://localhost:3001
STAFF_ORIGIN=http://localhost:3002
PUBLIC_ORIGIN=http://localhost:3000
# Local authentication is disabled unless both variables explicitly enable it.
LOCAL_AUTH_ENABLED=false
LOCAL_AUTH_HOST=localhost
# Production OIDC uses discovery, PKCE, state and nonce. No browser bearer-token storage.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Supply a random 32-byte base64 secret through a secret manager; no default is accepted.
SESSION_KEY=
FIELD_ENCRYPTION_KEY=
SENSITIVE_INTAKE_ENABLED=false
EVIDENCE_STORAGE_PROVIDER=disabled
NOTIFICATION_PROVIDER=disabled
# Use in-app only for explicitly configured synthetic activity delivery.
RANKING_CUSTODY_PROVIDER=disabled
RECOVERY_JOURNAL_PROVIDER=disabled

NEXT_TELEMETRY_DISABLED=1
INTERNAL_API_KEY=
